{
  "name": "proxypress",
  "productName": "ProxyPress",
  "version": "1.0.3",
  "description": "A browser-based MTG proxy maker",
  "main": "main.js",
  "author": {
    "name": "Justin",
    "email": "zoro11031@users.noreply.github.com"
  },
  "homepage": "https://github.com/zoro11031/proxypress",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux AppImage deb rpm pacman"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.zoro11031.proxypress",
    "productName": "ProxyPress",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "icon.png",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "../proxy-press.html",
        "to": "proxy-press.html"
      },
      {
        "from": "../og.png",
        "to": "og.png"
      },
      {
        "from": "../assets",
        "to": "assets",
        "filter": [
          "fonts/**/*",
          "frames/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "msi",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico",
      "artifactName": "Proxy-Press-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Proxy Press"
    },
    "msi": {
      "oneClick": false,
      "artifactName": "Proxy-Press-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "icon": "icon.png",
      "category": "Graphics",
      "maintainer": "Justin <zoro11031@users.noreply.github.com>",
      "executableName": "proxypress",
      "artifactName": "Proxy-Press-${version}.${ext}",
      "desktop": {
        "Name": "Proxy Press"
      },
      "synopsis": "A browser-based MTG proxy maker",
      "description": "Turn a decklist into print-ready Magic proxies. Print at home with bleed and cut guides, or order from MakePlayingCards."
    },
    "deb": {
      "priority": "optional",
      "packageCategory": "graphics",
      "artifactName": "Proxy-Press-${version}.${ext}"
    },
    "rpm": {
      "category": "Applications/Graphics",
      "artifactName": "Proxy-Press-${version}.${ext}"
    },
    "pacman": {
      "artifactName": "Proxy-Press-${version}.${ext}"
    }
  }
}
