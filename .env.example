# Copy to .env and change.
# Optional sign-in page password. Leave empty for no login (home network only).
PROXY_PRESS_PASSWORD=
# Or a browser login prompt instead (user:password).
PROXY_PRESS_AUTH=

# Address to publish on. 127.0.0.1 = this machine only; use the server's LAN IP
# (e.g. 192.168.1.10) to reach it from other devices on your network.
PROXY_PRESS_BIND=127.0.0.1
PROXY_PRESS_PORT=8642

# Public origin, including your subdomain. Used when creating share links.
# Example: https://proxy.example.com (no trailing path).
# Leave empty to use the address currently open in the browser.
PUBLIC_URL=
# Total artwork storage for shared decks, in MB (20 GB).
# Stored in the cache volume and survives container rebuilds.
SHARE_STORAGE_MB=20480
# Artwork limit per shared deck, in MB (1 GB).
SHARE_DECK_MB=1024
